# Copy to `.env` and fill in. `.env` itself is git-ignored.

# ── Database ─────────────────────────────────────────────────────────────────
# DATABASE_URL is what Prisma migrations use; the DB_* values are what the
# MariaDB adapter connects with at runtime (see src/lib/db.ts). Keep them
# pointing at the same database.
DATABASE_URL=mysql://user:password@localhost:3306/eservice
DB_HOST=localhost
DB_USER=eservice
DB_PASSWORD=
DB_NAME=eservice

# ── HTTP ─────────────────────────────────────────────────────────────────────
PORT=4000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# ── Sessions ─────────────────────────────────────────────────────────────────
# How long a signed-in session lasts. Both accept 30s / 15m / 12h / 7d, or a
# bare number of seconds. The JWT's own expiry is derived from the absolute
# value, so the token and the session row can never disagree about when the
# session ended.
#
# SESSION_ABSOLUTE_TIMEOUT - hard limit measured from sign-in.
# SESSION_IDLE_TIMEOUT     - how long an unattended session stays usable.
SESSION_ABSOLUTE_TIMEOUT=12h
SESSION_IDLE_TIMEOUT=30m

# Signs every session token. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#
# Required: with NODE_ENV=production the server refuses to start without it,
# rather than falling back to the placeholder secret committed in source —
# anyone who has read this repository could otherwise forge a session.
# Rotating it signs every user out, which is the intended emergency action.
JWT_SECRET=

# ── SMS (SMSETHIOPIA) ────────────────────────────────────────────────────────
SMS_API=
SMS_TOKEN=
SENDER_NAME=
CALLBACK=

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate with `npm run vapid`. Long-lived: rotating these invalidates every
# stored browser subscription, forcing all users to re-enable notifications.
# VAPID_SUBJECT must be a mailto: or https: URI a push service can contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
