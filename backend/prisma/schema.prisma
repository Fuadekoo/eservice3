generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  // url      = env("DATABASE_URL")
}

enum role {
  admin
  manager
  staff
  customer
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  BLOCKED
}

model User {
  id               String      @id @default(uuid())
  name             String?
  firstName        String?
  fatherName       String?
  lastName         String?
  image            String?
  gender           Gender?     @default(OTHER)
  status           UserStatus? @default(ACTIVE)
  username         String      @unique
  phoneNumber      String      @unique
  password         String
  roleId           String?
  role             Role?       @relation(fields: [roleId], references: [id])
  isActive         Boolean     @default(true)
  phoneVerified    Boolean     @default(false)
  twoFactorEnabled Boolean     @default(false)
  twoFactorSecret  String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  staff                staff?
  requests             request[]
  requestForOthers     requestForOther[]
  appointments         appointment[]
  reportsSent          report[]              @relation("ReportSender")
  reportsReceived      report[]              @relation("ReportReceiver")
  sessions             session[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  webPushSubscriptions WebPushSubscription[]
}

model session {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName      String?
  deviceType      String?
  browser         String?
  operatingSystem String?
  ipAddress       String?
  userAgent       String?  @db.Text
  lastSeenAt      DateTime @default(now())

  /// When this session stops being accepted, whatever happens in the meantime.
  /// Set from SESSION_ABSOLUTE_TIMEOUT at sign-in. Nullable only so rows that
  /// predate the column keep loading; `requireAuth` treats a null as expired
  /// rather than as "never expires", which is the safe reading.
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([userId])
  @@index([lastSeenAt])
  @@index([expiresAt])
  @@map("session")
}

model WebPushSubscription {
  id String @id @default(cuid())

  /// Where the browser's push service takes delivery. Unique because the same
  /// browser re-subscribing must update its row rather than grow a second one —
  /// otherwise every re-registration doubles the notifications it receives.
  ///
  /// Sized rather than left to the default 191 characters: FCM and Mozilla
  /// endpoints run past that, and a truncated one is undeliverable.
  endpoint String @unique @db.VarChar(512)

  /// The subscription's public key and auth secret, base64url as the browser
  /// hands them over. Both are needed to encrypt a payload for this endpoint.
  p256dh String @db.VarChar(255)
  auth   String @db.VarChar(255)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// What the device calls itself, so the settings screen can list "Chrome on
  /// Windows" rather than an opaque URL nobody can tell apart.
  userAgent String? @db.VarChar(512)

  createdAt DateTime @default(now())

  /// The last time this endpoint accepted a push. A subscription the push
  /// service has quietly retired is deleted on the 404 or 410 it answers with,
  /// so a stale row here means a device that has simply been idle.
  lastSeenAt DateTime @default(now())

  // Sending to a person means reading every row they own.
  @@index([userId])
  @@map("web_push_subscription")
}

model Notification {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  /// What was pushed, and where clicking it goes. Held here rather than rebuilt
  /// from the contact, because a notification should read as it did when it was
  /// sent even after the conversation it referred to has moved on.
  title String
  body  String  @db.Text
  url   String  @default("/")
  icon  String?

  /// Which kind of event this was — `message`, `assignment`, `signin`. Decides
  /// the icon the inbox draws and the sound the desk plays.
  kind String @default("message")

  /// Stable id of the source event, e.g. `message:412`. Unique per user, so a
  /// webhook Meta delivered twice can never insert the notification twice.
  dedupeKey String?

  createdAt DateTime @default(now())

  /// A push service accepted this — which is not proof any device showed it.
  pushedAt DateTime?

  /// When the person opened it, by clicking the push or from the inbox. Null is
  /// what the unread badge counts.
  readAt DateTime?

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notification")
}

model staff {
  id                      String                   @id @default(cuid())
  /// One staff row per person, which is how a user gets an office: role.officeId
  /// says which office a role definition belongs to, not where the holder works.
  /// The code always assumed a single row, so the database now guarantees it
  /// rather than leaving a second one to be silently ignored.
  userId                  String                   @unique
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  officeId                String
  office                  Office                   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @default(now()) @updatedAt
  appointments            appointment[]
  approvedStaffRequests   request[]                @relation("ApproveStaff")
  approvedManagerRequests request[]                @relation("ApproveManager")
  mergedRequests          request[]                @relation("RequestMergedBy")
  approvedStaffProxy      requestForOther[]        @relation("ProxyApproveStaff")
  approvedManagerProxy    requestForOther[]        @relation("ProxyApproveManager")
  serviceAssignments      serviceStaffAssignment[]

  @@map("staff")
}

model Office {
  id          String   @id @default(cuid())
  name        String
  phoneNumber String?
  roomNumber  String
  address     String
  subdomain   String
  logo        String?
  slogan      String?
  settings    Json     @default("{}")
  status      Boolean  @default(true)
  startedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  staffs           staff[]
  service          service[]
  availability     officeAvailability?
  auditLogs        AuditLog[]
  requests         request[]           @relation("OfficeRequests")
  requestsForOther requestForOther[]   @relation("OfficeRequestsForOther")
  appointments     appointment[]       @relation("OfficeAppointments")

  @@map("office")
}

model officeAvailability {
  id       String @id @default(cuid())
  officeId String @unique
  office   Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  // Default work schedule (day of week: 0=Sunday, 1=Monday, ..., 6=Saturday)
  // Format: { "1": { "start": "09:00", "end": "17:00", "available": true }, ... }
  defaultSchedule Json @default("{}")

  // Slot duration in minutes (e.g., 30, 60)
  slotDuration Int @default(30)

  // Unavailable date ranges (e.g., holidays, maintenance periods)
  // Format: [{ "start": "2024-01-01", "end": "2024-01-07", "reason": "Holiday" }]
  unavailableDateRanges Json @default("[]")

  // Unavailable specific dates (single days)
  // Format: ["2024-12-25", "2024-12-31"]
  unavailableDates Json @default("[]")

  // Specific date overrides (for special hours on specific dates)
  // Format: { "2024-12-24": { "start": "10:00", "end": "14:00", "available": true } }
  dateOverrides Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("office_availability")
}

/// A job description, independent of any office.
///
/// Roles used to carry an officeId, so every office kept its own copy of the
/// same role. Which office someone works in is recorded once, on their staff
/// row; a role only says what they may do. One manager role now serves every
/// office.
model Role {
  id          String   @id @default(cuid())
  /// Unique now that roles are global — two roles sharing a name would be
  /// indistinguishable in every dropdown.
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  users           User[]
  rolePermissions RolePermission[]

  @@map("role")
}

model Permission {
  id              String           @id @default(cuid())
  code            String?          @unique
  name            String
  description     String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  rolePermissions RolePermission[]

  @@map("permission")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permission")
}

model gallery {
  id          String         @id @default(cuid())
  name        String
  description String?
  images      galleryImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("gallery")
}

model galleryImage {
  id        String   @id @default(cuid())
  galleryId String
  filename  String // Filename stored in filedata folder
  order     Int      @default(0) // Order for displaying images
  gallery   gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([galleryId])
  @@map("gallery_image")
}

model service {
  id               String                   @id @default(cuid())
  name             String
  description      String
  timeToTake       String
  roomNumber       String?
  officeId         String
  office           Office                   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  requests         request[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @default(now()) @updatedAt
  requestForOthers requestForOther[]
  staffAssignments serviceStaffAssignment[]
  requirements     requirement[]
  serviceFors      serviceFor[]

  @@map("service")
}

// a requrement to take the service
model requirement {
  id          String   @id @default(cuid())
  name        String
  description String?
  serviceId   String
  service     service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("requirement")
}

model serviceFor {
  id          String   @id @default(cuid())
  name        String
  description String?
  serviceId   String
  service     service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("service_for")
}

model customerSatisfaction {
  id               String            @id @default(cuid())
  requestId        String            @unique
  request          request           @relation(fields: [requestId], references: [id], onDelete: Cascade)
  rating           Int
  comment          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  requestForOthers requestForOther[]

  @@map("customer_satisfaction")
}

// ============================================
// AUDIT LOG
// ============================================
model AuditLog {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  actor     String
  role      String?
  action    String
  resource  String
  status    String
  metadata  Json?

  // Office Relationship (NULL for super admin actions)
  officeId String?
  office   Office? @relation(fields: [officeId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([timestamp])
  @@index([officeId])
  @@map("audit_log")
}

enum requestStatus {
  pending
  approved
  rejected
}

enum requestStatusAdmin {
  pending
  approved
  rejected
}

enum reportStatus {
  pending
  sent
  received
  read
  archived
  approved
  rejected
}

model request {
  id               String             @id @default(cuid())
  /// Human-readable reference the customer is given (REQ-YYYYMMDD-NNNNN).
  /// Unique so it can be quoted over the phone and looked up directly.
  requestNumber    String             @unique
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId        String
  service          service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  officeId         String?
  office           Office?            @relation("OfficeRequests", fields: [officeId], references: [id], onDelete: Cascade)
  currentAddress   String
  date             DateTime
  statusbystaff    requestStatus
  statusbyadmin    requestStatusAdmin
  // add the the approve requst staff id and note write by the approve staff
  approveStaffId   String?
  approveStaff     staff?             @relation("ApproveStaff", fields: [approveStaffId], references: [id])
  approveManagerId String?
  approveManager   staff?             @relation("ApproveManager", fields: [approveManagerId], references: [id])
  approveNote      String?            @db.Text

  /// Why the request was turned down, in the decider's words.
  ///
  /// The reason used to exist only inside the SMS and the push notification
  /// that announced the rejection. Neither is reachable from the portal, so a
  /// customer who missed the message — or simply came back a week later — was
  /// shown "Rejected" and nothing else. Stored here it survives, and the
  /// customer's own request page can show it.
  rejectionReason String? @db.Text

  /// When the decision that produced the current status was taken.
  decidedAt DateTime?

  /// The request this one was merged into, when an office judges it a
  /// duplicate. The row is kept rather than deleted: the customer was given
  /// this reference number, so quoting it must keep working and must lead to
  /// wherever the work actually continued.
  mergedIntoId     String?
  mergedInto       request?  @relation("RequestMerge", fields: [mergedIntoId], references: [id])
  mergedDuplicates request[] @relation("RequestMerge")
  mergedAt         DateTime?
  /// Who merged it, and the note they left explaining why.
  mergedById       String?
  mergedBy         staff?    @relation("RequestMergedBy", fields: [mergedById], references: [id])
  mergeNote        String?   @db.Text

  customerSatisfaction customerSatisfaction?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now()) @updatedAt
  appointments         appointment[]
  fileData             fileData[]

  @@index([mergedIntoId])
  @@map("request")
}

/// One row per calendar day holding the last sequence number handed out that
/// day. Incremented atomically so concurrent applications can never be offered
/// the same request number — see `generateRequestNumber`.
model requestSequence {
  /// The day the counter belongs to, as `YYYYMMDD`.
  id  String @id
  seq Int    @default(0)

  @@map("request_sequence")
}

/// A request a customer submits for a family member or dependent.
///
/// It goes through exactly the same two-step review as an ordinary request —
/// a staff member checks it, then a manager signs it off — so it carries the
/// same decision columns. It did not use to: it had a single `status` and no
/// way to record a decision at all, while the dashboard listed these rows
/// alongside ordinary ones and pointed its Approve button at the `request`
/// endpoints. Approving a family request therefore answered "Request not
/// found", because the id belonged to this table.
model requestForOther {
  id             String   @id @default(cuid())
  /// The reference the applicant is given, on the same REQ-YYYYMMDD-NNNNN
  /// series as ordinary requests so one number space covers both. Nullable
  /// for rows created before the column existed.
  requestNumber  String?  @unique
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId      String
  service        service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  officeId       String?
  office         Office?  @relation("OfficeRequestsForOther", fields: [officeId], references: [id], onDelete: Cascade)
  currentAddress String
  name           String
  phoneNumber    String
  relationship   String
  date           DateTime

  /// The overall outcome, kept for the rows and readers that predate the split
  /// below: pending until both steps approve, rejected the moment either one
  /// does. Every write goes through `applyProxyDecision`, so it cannot drift
  /// from the two columns it summarises.
  status requestStatus

  /// The staff check and the manager sign-off, mirroring `request`.
  statusbystaff requestStatus      @default(pending)
  statusbyadmin requestStatusAdmin @default(pending)

  approveStaffId   String?
  approveStaff     staff?    @relation("ProxyApproveStaff", fields: [approveStaffId], references: [id])
  approveManagerId String?
  approveManager   staff?    @relation("ProxyApproveManager", fields: [approveManagerId], references: [id])
  approveNote      String?   @db.Text
  rejectionReason  String?   @db.Text
  decidedAt        DateTime?

  customerSatisfaction   customerSatisfaction? @relation(fields: [customerSatisfactionId], references: [id])
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @default(now()) @updatedAt
  appointments           appointment[]
  customerSatisfactionId String?
  fileData               fileData[]

  @@map("request_for_other")
}

model fileData {
  id                String           @id @default(cuid())
  name              String
  filepath          String
  description       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  requestForOther   requestForOther? @relation(fields: [requestForOtherId], references: [id])
  requestForOtherId String?
  request           request?         @relation(fields: [requestId], references: [id])
  requestId         String?
  report            report?          @relation(fields: [reportId], references: [id])
  reportId          String?

  @@map("file_data")
}

model appointment {
  id String @id @default(cuid())

  /// The application this slot belongs to. Optional because an application is
  /// one of two kinds: an ordinary `request`, or a `requestForOther` submitted
  /// for a family member. Exactly one of `requestId` / `requestForOtherId` is
  /// set. It used to be required, which made an appointment for a dependent
  /// impossible to record at all — the row could not be written.
  requestId         String?
  request           request?         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  officeId          String?
  office            Office?          @relation("OfficeAppointments", fields: [officeId], references: [id], onDelete: Cascade)
  date              DateTime
  time              String?
  status            String           @default("pending")
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt
  user              User?            @relation(fields: [userId], references: [id])
  userId            String?
  approveStaff      staff?           @relation(fields: [staffId], references: [id])
  staffId           String?
  requestForOther   requestForOther? @relation(fields: [requestForOtherId], references: [id])
  requestForOtherId String?

  @@map("appointment")
}

model otp {
  id          String @id @default(uuid())
  phoneNumber String
  code        Int
}

model tourismArea {
  id          String   @id @default(cuid())
  name        String
  photo       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tourism_area")
}

// Service-Staff Assignment: Many-to-Many relationship
// Office manager can assign services to staff (same office only)
model serviceStaffAssignment {
  id        String   @id @default(cuid())
  serviceId String
  service   service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staffId   String
  staff     staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ensure unique service-staff pairs
  @@unique([serviceId, staffId])
  @@index([serviceId])
  @@index([staffId])
  @@map("service_staff_assignment")
}

model administration {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  image       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("administration")
}

model about {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  image       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("about")
}

model report {
  id               String       @id @default(cuid())
  name             String
  description      String       @db.Text
  fileData         fileData[]
  reportSentTo     String
  reportSentToUser User         @relation("ReportReceiver", fields: [reportSentTo], references: [id])
  receiverStatus   reportStatus @default(pending)
  reportSentBy     String
  reportSentByUser User         @relation("ReportSender", fields: [reportSentBy], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("report")
}
